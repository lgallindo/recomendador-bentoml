# Copie para .env nesta pasta (o .env é ignorado pelo git):
#   cp material/litellm/.env.example material/litellm/.env

# Chave do PROXY: quem chama http://127.0.0.1:4000 apresenta esta no header.
LITELLM_MASTER_KEY=sk-loja-local-troque

# Onde o proxy encontra o Ollama.
#   proxy rodando no host (uv)      → http://127.0.0.1:11434  (exige a porta publicada)
#   proxy rodando em contêiner      → o compose desta pasta sobrescreve para http://ollama:11434
OLLAMA_API_BASE=http://127.0.0.1:11434

# Chave do PROVEDOR (opcional; só para o alias loja-chat-nuvem). Deixe vazia se não tiver.
OPENAI_API_KEY=
